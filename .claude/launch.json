{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "npm run build && npm run start -- -p 3000"],
      "port": 3000
    }
  ]
}
